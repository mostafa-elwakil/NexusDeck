{
  "name": "Media Control",
  "size": "cyd",
  "rows": 3,
  "cols": 4,
  "buttons": [
    {
      "label": "Spotify",
      "icon": "🎵",
      "color": "#1db954",
      "action": {
        "type": "open_url",
        "url": "https://open.spotify.com"
      }
    },
    {
      "label": "YouTube",
      "icon": "📺",
      "color": "#ff0000",
      "action": {
        "type": "open_url",
        "url": "https://youtube.com"
      }
    },
    {
      "label": "VLC",
      "icon": "🎥",
      "color": "#ff8800",
      "action": {
        "type": "open_app",
        "app": "vlc.exe"
      }
    },
    {
      "label": "Rec Toggle",
      "icon": "⏺️",
      "color": "#ea4335",
      "action": {
        "type": "obs_control",
        "operation": "toggle_recording"
      }
    },
    {
      "label": "Scene: Game",
      "icon": "🎮",
      "color": "#2496ed",
      "action": {
        "type": "obs_control",
        "operation": "set_scene",
        "scene": "Game"
      }
    },
    {
      "label": "",
      "icon": "🕐",
      "color": "#1a1a3e",
      "action": null,
      "widget": {
        "type": "clock"
      }
    },
    {
      "label": "",
      "icon": "⏱️",
      "color": "#1a2e3e",
      "action": null,
      "widget": {
        "type": "stopwatch"
      }
    },
    {
      "label": "",
      "icon": "⏲️",
      "color": "#2d2d6f",
      "action": null,
      "widget": {
        "type": "timer",
        "config": {
          "duration": 300
        }
      }
    },
    {
      "label": "Browser",
      "icon": "🌐",
      "color": "#4285f4",
      "action": {
        "type": "open_url",
        "url": "https://google.com"
      }
    },
    {
      "label": "Discord",
      "icon": "💬",
      "color": "#7289da",
      "action": {
        "type": "open_app",
        "app": "Discord.exe"
      }
